diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index e0bb7ff..1a927b0 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2204,6 +2204,34 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 		subcode = ut->uu_subcode;
 		etype = ut->uu_exception;
 
+		/* miro: SpringBoard / PerfPowerService crash loops stop producing
+		 * corpses, so log the registers here while the thread still has them.
+		 * Cap at three per name to keep the console ring usable. */
+		if (p == current_proc()) {
+			static struct { char name[24]; int count; } logged[4];
+			const char *nm = p->p_comm;
+			if (strncmp(nm, "SpringBoard", 11) == 0 ||
+			    strncmp(nm, "PerfPowerService", 16) == 0) {
+				int slot = -1;
+				for (int i = 0; i < 4; i++) {
+					if (logged[i].name[0] == 0 || strncmp(logged[i].name, nm, 23) == 0) {
+						slot = i;
+						break;
+					}
+				}
+				if (slot >= 0 && logged[slot].count < 3) {
+					if (logged[slot].name[0] == 0) {
+						strlcpy(logged[slot].name, nm, sizeof(logged[slot].name));
+					}
+					logged[slot].count++;
+					extern void miro_crash_log(const char *, int, int, uint64_t, uint64_t);
+					miro_crash_log(nm, proc_getpid(p), WTERMSIG(rv),
+					    ((uint64_t)ut->uu_exception << 32) | (uint32_t)ut->uu_code,
+					    ut->uu_subcode);
+				}
+			}
+		}
+
 		/* Defualt to EXC_CRASH if the exception is not an EXC_RESOURCE or EXC_GUARD */
 		if (etype != EXC_RESOURCE || etype != EXC_GUARD) {
 			etype = EXC_CRASH;
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 5c88e69..b80fb29 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -827,6 +827,55 @@ exception_triage(
 	return exception_triage_thread(exception, code, codeCnt, thread);
 }
 
+/*
+ * miro: console crash report for the bring-up. launchd stops creating corpses
+ * after a few crashes ("Too many corpses being created"), so print what
+ * symbolication needs directly: user registers, a frame-pointer backtrace,
+ * the dyld shared-cache slide and the main binary's Mach-O header address.
+ * Called from proc_prepareexit on the exiting (crashing) thread.
+ */
+#include <vm/vm_shared_region.h>
+#include <arm/thread.h>
+
+void
+miro_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
+{
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss = find_user_regs(thread);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("MIRO-CRASH %s[%d] sig %d code 0x%llx sub 0x%llx slide 0x%llx mh 0x%llx\n",
+	    name, pid, sig, code, subcode, slide, mh);
+	if (ss == NULL || !is_saved_state64(ss)) {
+		return;
+	}
+	uint64_t fp = get_saved_state_fp(ss);
+	printf("MIRO-CRASH %s pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx far 0x%llx\n", name,
+	    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss), fp,
+	    (uint64_t)saved_state64(ss)->far);
+
+	char line[256];
+	int n = snprintf(line, sizeof(line), "MIRO-CRASH %s bt", name);
+	for (int i = 0; i < 10 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
+
 kern_return_t
 bsd_exception(
 	exception_type_t        exception,
