+static void
+miro_cache_list_dir(const char *path, char *out, size_t size)
+{
+	out[0] = 0;
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, vfs_context_current()) != 0) {
+		return;
+	}
+	char buf[1024];
+	struct uio *uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio) {
+		uio_addiov(uio, (user_addr_t)(uintptr_t)buf, sizeof(buf));
+		int eofflag = 0, numdirent = 0;
+		if (VNOP_READDIR(vp, uio, 0, &eofflag, &numdirent, vfs_context_current()) == 0) {
+			size_t used = sizeof(buf) - uio_resid(uio), off = 0, o = 0;
+			while (off + 9 <= used) {
+				struct { uint32_t ino; uint16_t reclen; uint8_t type; uint8_t namlen; char name[1]; } *dp =
+				    (void *)(buf + off);
+				if (dp->reclen < 9 || off + dp->reclen > used) break;
+				size_t n = dp->namlen;
+				bool dot = (n == 1 && dp->name[0] == '.');
+				bool dotdot = (n == 2 && dp->name[0] == '.' && dp->name[1] == '.');
+				if (n && off + 8 + n <= used && !dot && !dotdot) {
+					if (o + n + 2 < size) {
+						if (o) out[o++] = ',';
+						memcpy(out + o, dp->name, n);
+						o += n;
+					}
+				}
+				off += dp->reclen;
+			}
+			out[o] = 0;
+		}
+		uio_free(uio);
+	}
+	vnode_put(vp);
+}
