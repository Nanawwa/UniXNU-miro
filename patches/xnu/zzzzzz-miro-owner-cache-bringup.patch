+static void
+native_owner_data_mkdirs(proc_t p, user_addr_t scratch)
+{
+	/* The scratch is one 4 KiB page and the mount arguments end well below
+	 * 0xe00; the existing helpers use 0xa00 and 0xc00. */
+	const user_addr_t where = scratch + 0xe00;
+	const size_t room = 0x1000 - 0xe00;
+	unsigned made = 0, existed = 0, failed = 0;
+	const char *first_failure = NULL;
+	int first_error = 0;
+	for (unsigned i = 0; i < sizeof(native_data_dirs) / sizeof(native_data_dirs[0]); i++) {
+		const char *path = native_data_dirs[i];
+		size_t length = strlen(path) + 1;
+		if (length > room) {
+			++failed;
+			if (!first_failure) { first_failure = path; first_error = ENAMETOOLONG; }
+			continue;
+		}
+		struct mkdir_args request = { .path = where, .mode = 0755 };
+		int32_t result = 0;
+		int error = copyout(path, where, length);
+		if (!error) {
+			error = mkdir(p, &request, &result);
+		}
+		if (!error) {
+			++made;
+		} else if (error == EEXIST) {
+			++existed;
+		} else {
+			++failed;
+			if (!first_failure) { first_failure = path; first_error = error; }
+		}
+	}
+	printf("MIRO-DIRS made=%u existed=%u failed=%u",
+	    made, existed, failed);
+	if (first_failure) {
+		printf(" first=%s err=%d", first_failure, first_error);
+	}
+	printf("\n");
+}
